<Window
    x:Class="NetOpsTerminal.App.Views.SshHostKeyPromptWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NetOpsTerminal.App.ViewModels"
    x:DataType="vm:SshHostKeyPromptViewModel"
    Title="SSH Host Key Verification"
    Width="520"
    Height="510"
    MinWidth="480"
    CanResize="False"
    CanMinimize="False"
    CanMaximize="False"
    Icon="/Assets/NetOpsTerminal.ico"
    WindowDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    TransparencyLevelHint="Transparent"
    TransparencyBackgroundFallback="{DynamicResource AppWindowBrush}"
    CornerRadius="12"
    Background="Transparent"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Border Classes="dialog-shell">
    <Border Classes="dialog-surface">
      <Grid RowDefinitions="35,Auto,*,Auto">
        <Border Grid.Row="0" Classes="dialog-titlebar"
                WindowDecorationProperties.ElementRole="TitleBar">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Image Classes="dialog-title-icon" Source="/Assets/NetOpsTerminal.ico" />
            <TextBlock Grid.Column="1" Classes="dialog-title"
                       Text="SSH Host Key Verification" />
            <Button Grid.Column="2" Classes="window-caption close-caption"
                    Width="24" Height="24" VerticalAlignment="Center"
                    WindowDecorationProperties.ElementRole="User"
                    Click="Cancel_OnClick" ToolTip.Tip="Close"
                    AutomationProperties.Name="Close SSH host key verification">
              <Path Width="8" Height="8" Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.25" Data="M3,3 L13,13 M13,3 L3,13" />
            </Button>
          </Grid>
        </Border>
    <Border
        Grid.Row="1"
        Padding="14,10"
        Background="{DynamicResource AppSurfaceBrush}"
        BorderBrush="{DynamicResource AppBorderBrush}"
        BorderThickness="0,0,0,1">
      <StackPanel Spacing="5">
        <TextBlock
            FontSize="17"
            FontWeight="Bold"
            Foreground="{DynamicResource AppDangerBrush}"
            IsVisible="{Binding IsChanged}"
            Text="⚠  SECURITY WARNING" />
        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Heading}" />
        <TextBlock Classes="muted" FontSize="11" Text="SSH host-key verification · SHA256" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="2">
      <StackPanel Margin="14" Spacing="10">
        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />

        <Border
            Padding="10"
            Background="{DynamicResource AppSidebarBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
          <Grid ColumnDefinitions="125,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <TextBlock Classes="muted" Text="Host" />
            <TextBlock Grid.Column="1" FontFamily="Consolas" Text="{Binding Host}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Classes="muted" Text="Port" />
            <TextBlock Grid.Row="1" Grid.Column="1" FontFamily="Consolas" Text="{Binding Port}" />
            <TextBlock Grid.Row="2" Classes="muted" Text="Algorithm" />
            <TextBlock Grid.Row="2" Grid.Column="1" FontFamily="Consolas" Text="{Binding Algorithm}" />
            <TextBlock Grid.Row="3" Classes="muted" IsVisible="{Binding IsUnknown}" Text="Presented key" />
            <TextBlock Grid.Row="3" Classes="muted" IsVisible="{Binding IsChanged}" Text="New fingerprint" />
            <TextBlock Grid.Row="3" Grid.Column="1" FontFamily="Consolas" Text="{Binding FingerprintSha256}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="4" Classes="muted" IsVisible="{Binding IsChanged}" Text="Previously trusted" />
            <TextBlock Grid.Row="4" Grid.Column="1" FontFamily="Consolas" Foreground="{DynamicResource AppDangerBrush}" IsVisible="{Binding IsChanged}" Text="{Binding TrustedFingerprintSha256}" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Border
            Padding="10"
            Background="{DynamicResource AppSecondarySurfaceBrush}"
            BorderBrush="{DynamicResource AppDangerBrush}"
            BorderThickness="1"
            CornerRadius="4"
            IsVisible="{Binding IsChanged}">
          <TextBlock
              Foreground="{DynamicResource AppDangerBrush}"
              Text="A changed key may mean the device was reset or another device is using this address. Confirm the new fingerprint with the device or your administrator before continuing."
              TextWrapping="Wrap" />
        </Border>

        <TextBlock
            Classes="muted"
            FontSize="11"
            IsVisible="{Binding IsUnknown}"
            Text="Trust Once applies only to this tab. Trust and Save writes the public host key to this application's known_hosts file. Your password is never saved."
            TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Border
        Grid.Row="3"
        Padding="10"
        Background="{DynamicResource AppSurfaceBrush}"
        BorderBrush="{DynamicResource AppBorderBrush}"
        BorderThickness="0,1,0,0">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
        <Button Classes="toolbar" Click="Cancel_OnClick" Content="Cancel" />
        <Button Classes="toolbar" Click="TrustOnce_OnClick" Content="Trust Once" IsVisible="{Binding IsUnknown}" />
        <Button Classes="accent" Click="TrustAndSave_OnClick" Content="Trust and Save" IsVisible="{Binding IsUnknown}" />
        <Button Classes="accent" Click="ReplaceAndSave_OnClick" Content="Trust new key and replace" IsVisible="{Binding IsChanged}" />
      </StackPanel>
    </Border>
      </Grid>
    </Border>
  </Border>
</Window>
