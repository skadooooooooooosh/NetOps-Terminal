<Window
    x:Class="NetOpsTerminal.App.Views.CredentialEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Credential Profile"
    Width="400"
    Height="340"
    CanResize="False"
    CanMinimize="False"
    CanMaximize="False"
    Icon="/Assets/NetOpsTerminal.ico"
    WindowDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    TransparencyLevelHint="Transparent"
    TransparencyBackgroundFallback="{DynamicResource AppWindowBrush}"
    CornerRadius="12"
    Background="Transparent"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Border Classes="dialog-shell">
    <Border Classes="dialog-surface">
    <Grid RowDefinitions="35,Auto,*,Auto">
    <Border Grid.Row="0" Classes="dialog-titlebar"
            WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <Image Classes="dialog-title-icon" Source="/Assets/NetOpsTerminal.ico" />
        <TextBlock x:Name="HeadingText" Grid.Column="1" Classes="dialog-title" Text="Add credential profile" />
        <Button Grid.Column="2" Classes="window-caption close-caption"
                Width="24" Height="24" VerticalAlignment="Center"
                WindowDecorationProperties.ElementRole="User"
                Click="Cancel_OnClick" ToolTip.Tip="Close"
                AutomationProperties.Name="Close Credential Profile">
          <Path Width="8" Height="8" Stretch="Uniform"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.25" Data="M3,3 L13,13 M13,3 L3,13" />
        </Button>
      </Grid>
    </Border>
    <TextBlock Grid.Row="1" Margin="14,8,14,0"
               Classes="dialog-subtitle" Text="Password protected by Windows Credential Manager" />

    <StackPanel Grid.Row="2" Margin="10" Spacing="5">
      <TextBlock Text="Profile name" />
      <TextBox x:Name="NameTextBox" MaxLength="120" />
      <TextBlock Text="Username" />
      <TextBox x:Name="UsernameTextBox" MaxLength="255" />
      <TextBlock x:Name="PasswordLabel" Text="Password" />
      <TextBox x:Name="PasswordTextBox" PasswordChar="●" />
      <TextBlock x:Name="PasswordHint" Classes="muted" FontSize="11"
                 Text="A password is required for a new profile." />
      <TextBlock x:Name="ValidationErrorText" Foreground="{DynamicResource AppDangerBrush}" FontSize="11"
                 IsVisible="False" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="3" Padding="10" Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
        <Button Classes="toolbar" Click="Cancel_OnClick" Content="Cancel" />
        <Button Classes="accent" Click="Save_OnClick" Content="Save credential" IsDefault="True" />
      </StackPanel>
    </Border>
    </Grid>
    </Border>
  </Border>
</Window>
