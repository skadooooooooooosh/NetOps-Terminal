<Window
    x:Class="NetOpsTerminal.App.Views.ConfirmationWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Confirm"
    Width="400"
    Height="180"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto">
    <StackPanel Margin="16" Spacing="8">
      <TextBlock x:Name="HeadingText" FontSize="17" FontWeight="SemiBold" />
      <TextBlock x:Name="MessageText" Classes="muted" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="1" Padding="10" Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
        <Button x:Name="CancelButton" Classes="toolbar" Click="Cancel_OnClick" Content="Cancel" IsCancel="True" />
        <Button x:Name="ConfirmButton" Classes="accent" Click="Confirm_OnClick" Content="Confirm" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
