<Window
    x:Class="NetOpsTerminal.App.Views.CredentialProfilesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:credentials="using:NetOpsTerminal.Core.Credentials"
    Title="Credential Profiles"
    Width="500"
    Height="340"
    CanResize="False"
    CanMinimize="False"
    CanMaximize="False"
    Icon="/Assets/NetOpsTerminal.ico"
    WindowDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    TransparencyLevelHint="Transparent"
    TransparencyBackgroundFallback="{DynamicResource AppWindowBrush}"
    CornerRadius="12"
    Background="Transparent"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Border Classes="dialog-shell">
    <Border Classes="dialog-surface">
    <Grid RowDefinitions="35,Auto,*,Auto">
    <Border Grid.Row="0" Classes="dialog-titlebar"
            WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <Image Classes="dialog-title-icon" Source="/Assets/NetOpsTerminal.ico" />
        <TextBlock Grid.Column="1" Classes="dialog-title" Text="Credential Profiles" />
        <Button Grid.Column="2" Classes="window-caption close-caption"
                Width="24" Height="24" VerticalAlignment="Center"
                WindowDecorationProperties.ElementRole="User"
                Click="Close_OnClick" ToolTip.Tip="Close"
                AutomationProperties.Name="Close Credential Profiles">
          <Path Width="8" Height="8" Stretch="Uniform"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.25" Data="M3,3 L13,13 M13,3 L3,13" />
        </Button>
      </Grid>
    </Border>
    <TextBlock Grid.Row="1" Margin="14,8,14,0"
               Classes="dialog-subtitle" Text="Reusable usernames and Windows-protected passwords" />

    <Grid Grid.Row="2" Margin="12" RowDefinitions="*,Auto">
      <ListBox x:Name="CredentialListBox">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="credentials:CredentialProfile">
            <Grid Margin="6,4" ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                <TextBlock Classes="muted" FontFamily="Cascadia Mono, Consolas" FontSize="11" Text="{Binding Username}" />
              </StackPanel>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="muted"
                         FontSize="10" Text="WINDOWS PROTECTED" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyText" Margin="12" HorizontalAlignment="Center"
                 VerticalAlignment="Center" Classes="muted"
                 Text="No credential profiles configured." />
      <TextBlock x:Name="ErrorText" Grid.Row="1" Margin="0,10,0,0"
                 Foreground="{DynamicResource AppDangerBrush}" IsVisible="False" TextWrapping="Wrap" />
    </Grid>

    <Border Grid.Row="3" Padding="10" Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
        <Button Classes="accent" Click="Add_OnClick" Content="+ Add credential" />
        <Button Grid.Column="1" Margin="8,0,0,0" Classes="toolbar" Click="Edit_OnClick" Content="Edit" />
        <Button Grid.Column="2" Margin="8,0,0,0" Classes="toolbar" Click="Delete_OnClick" Content="Delete" />
        <Button Grid.Column="4" Classes="toolbar" Click="Close_OnClick" Content="Close" />
      </Grid>
    </Border>
    </Grid>
    </Border>
  </Border>
</Window>
