<Window
    x:Class="NetOpsTerminal.App.Views.DeviceImportReviewWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:devices="using:NetOpsTerminal.Application.Devices"
    Title="Review device import"
    Width="550" Height="500"
    MinWidth="500" MinHeight="420"
    CanMinimize="False" CanMaximize="False"
    Icon="/Assets/NetOpsTerminal.ico"
    WindowDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    TransparencyLevelHint="Transparent"
    TransparencyBackgroundFallback="{DynamicResource AppWindowBrush}"
    CornerRadius="12"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="Transparent">
  <Border Classes="dialog-shell">
    <Border Classes="dialog-surface">
      <Grid RowDefinitions="35,Auto,Auto,*,Auto">
        <Border Classes="dialog-titlebar"
                WindowDecorationProperties.ElementRole="TitleBar">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Image Classes="dialog-title-icon" Source="/Assets/NetOpsTerminal.ico" />
            <TextBlock Grid.Column="1" Classes="dialog-title" Text="Review device import" />
            <Button Grid.Column="2" Classes="window-caption close-caption"
                    Width="24" Height="24" VerticalAlignment="Center"
                    WindowDecorationProperties.ElementRole="User"
                    Click="Cancel_OnClick" ToolTip.Tip="Close"
                    AutomationProperties.Name="Close Review device import">
              <Path Width="8" Height="8" Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.25" Data="M3,3 L13,13 M13,3 L3,13" />
            </Button>
          </Grid>
        </Border>

        <TextBlock Grid.Row="1" x:Name="SummaryText" Classes="dialog-subtitle"
                   Margin="14,8,14,0" />

        <Grid Grid.Row="2" Margin="14,12,14,10"
              ColumnDefinitions="*,*" ColumnSpacing="12">
          <StackPanel Spacing="5">
            <TextBlock FontWeight="SemiBold" Text="If a device exists" />
            <StackPanel Spacing="4">
              <RadioButton x:Name="KeepBothRadio" GroupName="ImportConflict"
                           IsChecked="True" Content="Keep both as copies" />
              <RadioButton x:Name="SkipRadio" GroupName="ImportConflict"
                           Content="Skip imported duplicates" />
              <RadioButton x:Name="UpdateRadio" GroupName="ImportConflict"
                           Content="Update matching devices" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock FontWeight="SemiBold" Text="Fallback SSH credential" />
            <ComboBox x:Name="CredentialComboBox" MinHeight="32"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="Use matching credential" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="3" Classes="card" Margin="14,0,14,8" Padding="6">
          <ScrollViewer>
            <ItemsControl x:Name="DevicesList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="devices:DeviceImportPreviewItem">
                  <Grid ColumnDefinitions="*,Auto" Margin="6,5">
                    <StackPanel Spacing="2">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                      <TextBlock Classes="muted" FontSize="9"
                                 Text="{Binding EndpointLabel}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               FontSize="9" Foreground="#ff6678"
                               IsVisible="{Binding !HasCredentialMatch}"
                               Text="Credential required" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <Border Grid.Row="4" Padding="12,9"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Classes="muted" FontSize="9" VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Text="Passwords and trusted host keys are not imported." />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Classes="toolbar" Click="Cancel_OnClick"
                      Content="Cancel" IsCancel="True" />
              <Button Classes="primary" Click="Import_OnClick"
                      Content="Import devices" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Border>
</Window>
