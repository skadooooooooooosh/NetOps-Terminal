<Window
    x:Class="NetOpsTerminal.App.Views.DeviceImportReviewWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:devices="using:NetOpsTerminal.Application.Devices"
    Title="Review device import" Width="560" Height="520"
    MinWidth="500" MinHeight="440" WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AppWindowBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
    <StackPanel Spacing="4">
      <TextBlock FontSize="17" FontWeight="SemiBold" Text="Review device import" />
      <TextBlock x:Name="SummaryText" Classes="muted" FontSize="10" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,16,0,12" ColumnDefinitions="*,*" ColumnSpacing="10">
      <StackPanel Spacing="5">
        <TextBlock FontWeight="SemiBold" Text="When a device already exists" />
        <ComboBox x:Name="ConflictComboBox" MinHeight="32" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="5">
        <TextBlock FontWeight="SemiBold" Text="Fallback credential" />
        <ComboBox x:Name="CredentialComboBox" MinHeight="32" PlaceholderText="Matching credentials only" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="2" Classes="card" Padding="8">
      <ScrollViewer>
        <ItemsControl x:Name="DevicesList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="devices:DeviceImportPreviewItem">
              <Grid ColumnDefinitions="*,Auto" Margin="4,6">
                <StackPanel Spacing="2">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                  <TextBlock Classes="muted" FontSize="9" Text="{Binding EndpointLabel}" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="9"
                           Foreground="#ff6678" IsVisible="{Binding !HasCredentialMatch}"
                           Text="Credential required" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <Grid Grid.Row="3" Margin="0,14,0,0" ColumnDefinitions="*,Auto">
      <TextBlock Classes="muted" FontSize="9" VerticalAlignment="Center"
                 Text="Only reviewed device metadata will be imported." />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="toolbar" Click="Cancel_OnClick" Content="Cancel" />
        <Button Classes="primary" Click="Import_OnClick" Content="Import devices" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
