<Window
    x:Class="NetOpsTerminal.App.Views.ConnectionErrorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SSH Connection Error"
    Width="480"
    Height="300"
    CanResize="False"
    CanMinimize="False"
    CanMaximize="False"
    Icon="/Assets/NetOpsTerminal.ico"
    WindowDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    TransparencyLevelHint="Transparent"
    TransparencyBackgroundFallback="{DynamicResource AppWindowBrush}"
    CornerRadius="12"
    Background="Transparent"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Border Classes="dialog-shell">
    <Border Classes="dialog-surface">
      <Grid RowDefinitions="35,Auto,*,Auto">
        <Border Grid.Row="0" Classes="dialog-titlebar"
                WindowDecorationProperties.ElementRole="TitleBar">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Image Classes="dialog-title-icon" Source="/Assets/NetOpsTerminal.ico" />
            <TextBlock x:Name="TitleText" Grid.Column="1" Classes="dialog-title"
                       Text="SSH Connection Error" />
            <Button Grid.Column="2" Classes="window-caption close-caption"
                    Width="24" Height="24" VerticalAlignment="Center"
                    WindowDecorationProperties.ElementRole="User"
                    Click="Close_OnClick" ToolTip.Tip="Close"
                    AutomationProperties.Name="Close connection error">
              <Path Width="8" Height="8" Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.25" Data="M3,3 L13,13 M13,3 L3,13" />
            </Button>
          </Grid>
        </Border>
        <Border Grid.Row="1" Padding="16,12"
                Background="{DynamicResource AppSecondarySurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
          <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold"
                     Text="SSH connection failed" TextWrapping="Wrap" />
        </Border>
        <ScrollViewer Grid.Row="2">
          <StackPanel Margin="16,12" Spacing="10">
            <TextBlock x:Name="UserMessageText" TextWrapping="Wrap" />
            <Border Padding="9" Background="{DynamicResource AppSidebarBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="5">
              <StackPanel Spacing="5">
                <TextBlock Classes="muted" FontSize="10" FontWeight="SemiBold"
                           Text="TECHNICAL DETAILS (SANITIZED)" />
                <TextBlock x:Name="TechnicalDetailsText" FontFamily="Cascadia Mono, Consolas"
                           FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock Classes="muted" FontSize="10"
                       Text="No password or terminal content is included in these details." />
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" Padding="10" Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
          <Button HorizontalAlignment="Right" Classes="toolbar" Click="Close_OnClick"
                  Content="Close" IsDefault="True" />
        </Border>
      </Grid>
    </Border>
  </Border>
</Window>