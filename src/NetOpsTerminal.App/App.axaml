<Application
    x:Class="NetOpsTerminal.App.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://NetOpsTerminal/Themes/Graphite.axaml" />
        <ResourceInclude Source="avares://NetOpsTerminal/Themes/IconResources.axaml" />
        <ResourceInclude Source="avares://NetOpsTerminal/Themes/ShellIconResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark"
                               Accent="{StaticResource AppAccentColor}"
                               RegionColor="{StaticResource AppWindowColor}" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://NetOpsTerminal/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
