<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>NetOpsTerminal</AssemblyName>
    <ApplicationTitle>NetOps Terminal</ApplicationTitle>
    <ApplicationIcon>Assets/NetOpsTerminal.ico</ApplicationIcon>
    <Product>NetOps Terminal</Product>
    <Description>Offline-first terminal workspace for network engineers.</Description>
    <Authors>NetOps Terminal</Authors>
    <VersionPrefix>1.0.0</VersionPrefix>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetOpsTerminal.Application\NetOpsTerminal.Application.csproj" />
    <ProjectReference Include="..\NetOpsTerminal.Infrastructure\NetOpsTerminal.Infrastructure.csproj" />
    <ProjectReference Include="..\NetOpsTerminal.Terminal.RoyalTerminal\NetOpsTerminal.Terminal.RoyalTerminal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/NetOpsTerminal.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

</Project>
