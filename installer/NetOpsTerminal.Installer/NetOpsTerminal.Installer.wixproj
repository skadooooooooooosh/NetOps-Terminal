<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <!-- The native e_sqlite3.dll is language-neutral but has a version resource. -->
    <SuppressSpecificWarnings>1101</SuppressSpecificWarnings>
    <Platform>x64</Platform>
    <InstallerVersion Condition="'$(InstallerVersion)' == ''">1.1.1</InstallerVersion>
    <OutputName>NetOpsTerminal-$(InstallerVersion)-win-x64</OutputName>
    <DefineConstants>$(DefineConstants);InstallerVersion=$(InstallerVersion);PublishRoot=$(PublishRoot)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>
</Project>
